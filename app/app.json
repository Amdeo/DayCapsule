{
  "expo": {
    "name": "DayCapsule",
    "slug": "daycapsule",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daycapsule",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.memorycapsule.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "允许 DayCapsule 访问您的照片以保存记忆",
        "NSCameraUsageDescription": "允许 DayCapsule 使用相机拍摄照片",
        "NSMicrophoneUsageDescription": "允许 DayCapsule 录制语音记忆",
        "NSPhotoLibraryAddUsageDescription": "允许 DayCapsule 保存图片到系统相册"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.memorycapsule.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidCleartextTraffic",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 DayCapsule 访问您的照片以保存记忆",
          "cameraPermission": "允许 DayCapsule 使用相机拍摄照片"
        }
      ],
      [
        "@sentry/react-native",
        {
          "enableSourceMapsUpload": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#6A89CC"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 DayCapsule 录制语音记忆"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
