# MemoryCapsule Environment Configuration Sample
# 复制此文件为 .env.local 并填入实际凭证

# 腾讯云 ASR (语音转写)
TENCENT_ASR_APP_ID=your_app_id_here
TENCENT_ASR_SECRET_ID=your_secret_id_here
TENCENT_ASR_SECRET_KEY=your_secret_key_here

# 百度 EasyDL (图像识别)
BAIDU_AI_API_KEY=your_api_key_here
BAIDU_AI_SECRET_KEY=your_secret_key_here
BAIDU_AI_MODEL_ID=your_model_id_here

# 天气服务 (可选)
WEATHER_API_KEY=your_weather_api_key_here

# 应用配置
APP_ENV=development
DEBUG_MODE=true

# 性能监控
ENABLE_PERFORMANCE_MONITORING=true

