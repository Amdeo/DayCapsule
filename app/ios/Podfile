# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'MemoryCapsule' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'MemoryCapsuleTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix for Apple Silicon Macs - exclude x86_64 architecture
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'
      end
    end

    # Fix for Xcode 16 / iOS SDK 26 - RCT-Folly clockid_t compatibility
    time_h_files = [
      'Pods/RCT-Folly/folly/portability/Time.h',
      'Pods/Headers/Private/RCT-Folly/folly/portability/Time.h',
      'Pods/Headers/Public/RCT-Folly/folly/portability/Time.h'
    ]

    time_h_files.each do |file|
      next unless File.exist?(file)

      content = File.read(file)

      # Only patch if not already patched
      if content.include?('typedef uint8_t clockid_t;') && !content.include?('#ifndef clockid_t')
        # Make file writable
        FileUtils.chmod('u+w', file)

        new_content = content.gsub(
          /typedef uint8_t clockid_t;/,
          "#ifndef clockid_t\ntypedef uint8_t clockid_t;\n#endif"
        )

        File.write(file, new_content)
        puts "Patched #{file} for Xcode 16 compatibility"
      end
    end
  end
end
