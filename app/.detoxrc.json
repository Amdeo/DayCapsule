{
  "configurations": {
    "ios.sim.debug": {
      "device": {
        "type": "iPhone 15"
      },
      "app": "ios.debug"
    },
    "ios.sim.release": {
      "device": {
        "type": "iPhone 15"
      },
      "app": "ios.release"
    },
    "android.emu.debug": {
      "device": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_4_API_30"
        }
      },
      "app": "android.debug"
    },
    "android.emu.release": {
      "device": {
        "type": "android.emulator",
        "device": {
          "avdName": "Pixel_4_API_30"
        }
      },
      "app": "android.release"
    }
  },
  "apps": {
    "ios.debug": {
      "type": "ios.app",
      "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/MemoryCapsule.app",
      "build": "xcodebuild -workspace ios/MemoryCapsule.xcworkspace -scheme MemoryCapsule -configuration Release -sdk iphonesimulator -derivedDataPath ios/build"
    },
    "ios.release": {
      "type": "ios.app",
      "binaryPath": "ios/build/Build/Products/Release-iphonesimulator/MemoryCapsule.app",
      "build": "xcodebuild -workspace ios/MemoryCapsule.xcworkspace -scheme MemoryCapsule -configuration Release -sdk iphonesimulator -derivedDataPath ios/build"
    },
    "android.debug": {
      "type": "android.apk",
      "binaryPath": "android/app/build/outputs/apk/debug/app-debug.apk",
      "build": "cd android && ./gradlew assembleDebug assembleAndroidTest -DtestBuildType=debug && cd .."
    },
    "android.release": {
      "type": "android.apk",
      "binaryPath": "android/app/build/outputs/apk/release/app-release.apk",
      "build": "cd android && ./gradlew assembleRelease assembleAndroidTest -DtestBuildType=release && cd .."
    }
  },
  "testRunner": "jest"
}

