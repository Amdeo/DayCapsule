          <mxGeometry x="40" y="20" width="320" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="范围：媒体上传与媒体获取。&#xa;取证约束：主运行时上传链路是 PhotoUploadQueue / VoiceUploadQueue -&gt; ApiClient.uploadFile() -&gt; MediaHandler -&gt; MediaRepository；本地媒体层是 SQLite（经 operations.ts 访问）；mediaCacheService.ts 真实存在，但不要把它误画成上传队列。" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
