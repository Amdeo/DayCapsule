          <mxGeometry x="40" y="210" width="1820" height="420" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="本地 DB（SQLite，经 operations.ts）&#xa;entry.media / syncStatus / 本地 uri&#xa;getEntryById / updateEntry / deleteEntry" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="70" y="300" width="260" height="120" as="geometry"/>
