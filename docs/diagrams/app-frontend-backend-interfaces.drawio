        </mxCell>
        <mxCell id="3" value="范围：登录 / 注册 / token 刷新；对应总览图中的 Auth 模块。&#xa;取证约束：主入口是 useAuthStore.login / register / loadAuth，网络层是 ApiClient，后端业务层级是 AuthHandler -&gt; AuthService。" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="40" y="70" width="1820" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="10" value="主调用时序" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=17;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="190" width="1820" height="400" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="用户在 Login / Register 页面提交表单" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="80" y="260" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="useAuthStore.login()&#xa;或 useAuthStore.register()" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="260" width="240" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="ApiClient.post('/auth/login')&#xa;或 ApiClient.post('/auth/register')" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="610" y="260" width="310" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="AuthHandler -&gt; AuthService" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#d9f0f7;strokeColor=#10739e;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="970" y="260" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="15" value="返回 user + token + refreshToken" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1270" y="260" width="250" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="16" value="MMKV Storage&#xa;auth:token&#xa;auth:refreshToken&#xa;auth:user" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1570" y="235" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="17" value="Zustand 更新&#xa;isAuthenticated=true&#xa;后续受保护请求携带 Authorization Header" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1270" y="390" width="550" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="18" value="App 冷启动 / 根布局初始化" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="80" y="470" width="190" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="19" value="useAuthStore.loadAuth()" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="320" y="470" width="240" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="20" value="读取 auth:token / auth:refreshToken / auth:user" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="610" y="470" width="310" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="恢复 user / token / refreshToken&#xa;当前取证未见它发起网络请求" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="970" y="470" width="420" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="边界提示&#xa;useAuthStore.refreshAuth() 存在，&#xa;但不要把它画成 ApiClient 401 自动刷新主链路" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1440" y="470" width="380" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="30" value="请求 / 响应摘要" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=17;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="630" width="860" height="590" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="/api/auth/register&#xa;请求：{ email, password }&#xa;响应：{ user, token, refreshToken }" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#10739e;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="80" y="710" width="240" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="/api/auth/login&#xa;请求：{ email, password }&#xa;响应：{ user, token, refreshToken }" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#10739e;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="350" y="710" width="240" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="/api/auth/refresh&#xa;请求：{ refreshToken }&#xa;响应：{ token, refreshToken, expiresIn }" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#10739e;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="620" y="710" width="240" height="165" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="Authorization Header&#xa;ApiClient.get / post / put / delete 会读取 auth:token&#xa;对受保护请求注入 Bearer token" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="80" y="915" width="780" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="主链路之外的刷新说明&#xa;ApiClient 内部 refreshWithLock() 直接 POST /auth/refresh；&#xa;它不通过额外 Auth 中间层，也不是从 useAuthStore.loadAuth 发起。" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="80" y="1060" width="780" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="40" value="状态变化 / 异常分支" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=17;align=left;verticalAlign=top;spacingTop=12;spacingLeft=14;" parent="1" vertex="1">
          <mxGeometry x="940" y="630" width="920" height="590" as="geometry"/>
        </mxCell>
        <mxCell id="41" value="登录 / 注册成功&#xa;user / token / refreshToken 写入 Zustand + MMKV&#xa;isAuthenticated=true" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="980" y="710" width="270" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="42" value="loadAuth 分支&#xa;若 token + user 存在则恢复登录态&#xa;否则清空内存状态" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1290" y="710" width="260" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="43" value="401 分支（非主登录链路）&#xa;任一受保护请求收到 401&#xa;ApiClient.refreshWithLock() -&gt; /api/auth/refresh&#xa;成功后重试原请求" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1590" y="710" width="230" height="170" as="geometry"/>
        </mxCell>
        <mxCell id="44" value="refresh 失败 / refreshToken 无效&#xa;服务端返回 401&#xa;调用方保持未授权，后续需重新登录" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="980" y="920" width="270" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="45" value="真实边界&#xa;1. 不额外发明 Auth 中间层&#xa;2. register / login / refresh 的后端业务层是真实的 AuthHandler -&gt; AuthService&#xa;3. middleware.Auth 只属于受保护路由鉴权，不在这三条业务链路内" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="1290" y="920" width="530" height="170" as="geometry"/>
        </mxCell>
