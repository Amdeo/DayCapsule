        <mxCell id="12" value="PhotoUploadQueue&#xa;pending_upload -&gt; uploading" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="390" y="250" width="240" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="VoiceUploadQueue&#xa;pending_upload -&gt; uploading" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="390" y="370" width="240" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="14" value="ApiClient.uploadFile('/media/upload')" style="rounded=1;whiteSpace=wrap;html=1;spacing=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" parent="1" vertex="1">
